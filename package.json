{
  "name": "beatmyvendor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "deploy/build-production.sh",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sql": "bash scripts/qualify-sql.sh",
    "test:phase10": "playwright test tests/phase10-polish.spec.ts",
    "test:phase11": "playwright test tests/phase11-journey.spec.ts",
    "test:journey": "bash scripts/run-journey.sh",
    "test:sql:staging": "bash scripts/run-sql-gate.sh",
    "qualify:staging": "npm run test:sql:staging && npm run test:journey",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:full": "npm run check && npm run test:e2e",
    "qualify": "npm run check && npm run test:sql",
    "qualify:full": "npm run check:full && npm run test:sql",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "stripe": "^22.6.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "^30.0.1",
    "typescript": "latest",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
