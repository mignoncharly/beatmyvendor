NEXT_PUBLIC_LEGAL_REPRESENTATIVE=Authorized representative
NEXT_PUBLIC_LEGAL_ADDRESS=Registered street, postal code, city, country
NEXT_PUBLIC_LEGAL_EMAIL=privacy@example.com
NEXT_PUBLIC_LEGAL_REGISTER=Register court and registration number
NEXT_PUBLIC_LEGAL_VAT_ID=VAT identification number
NEXT_PUBLIC_PRIVACY_AUTHORITY=Competent supervisory authority

# Bearer secret for POST /api/maintenance/retention
CRON_SECRET=replace-with-a-long-random-secret
