NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe server-side configuration
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_VENDOR_INTRODUCTION_PRICE_ID=price_your-introduction-price

# Resend transactional email
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL="BeatMyVendor <notifications@beatmyvendor.com>"
RESEND_REPLY_TO_EMAIL=support@beatmyvendor.com
EMAIL_DELIVERY_BATCH_SIZE=25

# Legal identity — replace every placeholder before launch
NEXT_PUBLIC_LEGAL_NAME=BeatMyVendor legal entity
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=Authorized representative
NEXT_PUBLIC_LEGAL_ADDRESS=Registered street, postal code, city, country
NEXT_PUBLIC_LEGAL_EMAIL=privacy@example.com
NEXT_PUBLIC_LEGAL_REGISTER=Register court and registration number
NEXT_PUBLIC_LEGAL_VAT_ID=VAT identification number
NEXT_PUBLIC_PRIVACY_AUTHORITY=Competent supervisory authority

# Bearer secret for both POST /api/maintenance/{retention,notifications}
CRON_SECRET=replace-with-a-long-random-secret
